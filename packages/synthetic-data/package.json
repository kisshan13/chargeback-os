{
  "name": "@packages/synthetic-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "build",
    "data",
    "scripts",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./build/schema.js",
      "default": "./build/schema.js"
    },
    "./validator": {
      "types": "./src/validator.ts",
      "import": "./build/validator.js",
      "default": "./build/validator.js"
    },
    "./collections": {
      "types": "./src/collections/index.ts",
      "import": "./build/collections/index.js",
      "default": "./build/collections/index.js"
    },
    "./store": {
      "types": "./src/store.ts",
      "import": "./build/store.js",
      "default": "./build/store.js"
    },
    "./data/source/*": "./data/source/*",
    "./data/investigation/*": "./data/investigation/*",
    "./data/evaluation/*": "./data/evaluation/*",
    "./manifest.json": "./data/manifest.json"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "validate": "tsx scripts/validate.ts",
    "build": "pnpm run generate && pnpm run validate && pnpm run build:types && pnpm run build:js",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:js": "node ../config/esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@packages/config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15"
  }
}
