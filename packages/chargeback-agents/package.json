{
  "name": "@packages/chargeback-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "build",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
