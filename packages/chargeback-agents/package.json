      "default": "./build/contracts/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./build/core/index.js",
      "default": "./build/core/index.js"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "import": "./build/adapters/index.js",
      "default": "./build/adapters/index.js"
    },
    "./agents": {
      "types": "./src/agents/index.ts",
      "import": "./build/agents/index.js",
      "default": "./build/agents/index.js"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "import": "./build/tools/index.js",
      "default": "./build/tools/index.js"
    }
  },
  "scripts": {
    "build": "node ../../packages/config/esbuild.config.mjs",
