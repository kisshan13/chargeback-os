NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173
API_PROXY_TARGET=http://localhost:5000

# Optional API origin for split deployments. Leave empty to use the same
# origin (recommended for the renderer, where Express serves the web build).
VITE_API_URL=

# Required to run the dispute investigation simulation. Keep this key in the
# server environment; it is never sent to the browser.
OPENAI_API_KEY=
# OpenAI API or another OpenAI-compatible endpoint. Include the /v1 path when
# the provider requires it. For example: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# The model identifier must be supported by the configured endpoint.
MOZAIK_MODEL=gpt-6-luna

# Copy this file to the repository root as .env. The API reads the root file
# even when started from apps/api. Restart the API after changing these values.

# Optional override. The default points to packages/synthetic-data/data.
SYNTHETIC_DATA_DIR=packages/synthetic-data/data
